{{define "content"}}{{$csrf := .CSRF}}{{with .Data}}
{{if not .DatabaseAvailable}}<p class="notice bad" role="alert"><strong>No database found (offline mode).</strong> Actions that need the database are unavailable until a sync creates it or it is rebuilt from the snapshot.</p>{{end}}
{{if not .SpotifyCredentialsPresent}}<p class="notice warn" role="status"><strong>Spotify credentials are not configured.</strong> Actions that call Spotify are unavailable.</p>{{end}}
<dl class="stats">
<div><dt>Database</dt><dd>{{if .DatabaseAvailable}}available{{else}}unavailable (offline){{end}}</dd></div>
<div><dt>Spotify credentials</dt><dd>{{if .SpotifyCredentialsPresent}}present{{else}}missing{{end}}</dd></div>
<div><dt>Last sync</dt><dd>{{if .LastSyncAt}}{{.LastSyncStatus}} · {{.LastSyncAt}}{{else}}never{{end}}</dd></div>
</dl>
{{if .Operator}}
{{with .Pending}}{{if .Available}}
<section id="pending" aria-labelledby="pending-h">
<h2 id="pending-h">Pending changes / Update website</h2>
{{if .Failed}}<p class="notice warn" role="status">Pending changes could not be read. Reload the page to retry.</p>
{{else}}
{{if .Clean}}<p class="notice"><strong>Up to date</strong> — the local database matches the catalog.</p>
{{else if .Unknown}}<p class="notice warn" role="status"><strong>The database's catalog state is unknown / needs check.</strong> Run the baseline check to compare the database with the catalog.
{{if .BaselinePage}}<a class="button" href="{{.BaselinePage}}">Run the baseline check</a>{{end}}</p>
{{else if .Offline}}<p class="notice bad" role="alert"><strong>No local database.</strong> Create it with a sync or rebuild it from the snapshot first.</p>
{{else}}<p class="notice warn" role="status"><strong>{{.Count}} {{if eq .Count 1}}artist{{else}}artists{{end}} modified since last database reconciliation.</strong></p>{{end}}
{{if .Rows}}<div class="table-wrap"><table>
<caption class="sr">Artists changed in the catalog since the database last applied it</caption>
<thead><tr><th scope="col">Artist</th><th scope="col">Changes</th><th scope="col">Needs</th></tr></thead>
<tbody>
{{range .Rows}}<tr><td><a href="/artists/{{.Slug}}">{{.Slug}}</a></td><td>{{range $i, $l := .Labels}}{{if $i}}, {{end}}{{$l}}{{end}}</td>
<td class="badges">{{if .Reconcile}}<span class="badge warn">needs reconcile</span>{{end}}{{if .Sync}}<span class="badge warn">needs Spotify sync</span>{{end}}{{if .SeedOnly}}<span class="badge">database seed only</span>{{end}}</td></tr>
{{end}}</tbody></table></div>
{{end}}
<p class="muted">Not every edit needs a Spotify API call: only Spotify ID, verified or enabled changes are synced; other edits only need the database seeded.</p>

<h3>Status</h3>
<ul class="status-lines">
<li class="status-db">{{.Database}}</li>
<li class="status-build">{{.Build}}</li>
<li class="status-release">{{.Release}}</li>
<li class="status-pr">{{.PR}}</li>
<li class="status-deploy">{{.Deploy}}</li>
</ul>

<h3>Update checklist</h3>
<ol class="stage-list">
{{range .Stages}}<li class="stage">
<p class="badges"><strong>{{.Title}}</strong> <span class="badge {{.NeedClass}}">{{.Need}}</span> <span class="badge {{.StatusClass}}">{{.Status}}</span></p>
{{if .Reason}}<p class="notice warn">{{.Reason}}</p>{{end}}
{{if .Note}}<p class="muted">{{.Note}}</p>{{end}}
{{if .Page}}<p><a class="button" href="{{.Page}}">Review…</a></p>
{{else if .CTADisabled}}<p><span class="button disabled" aria-disabled="true">{{.CTADisabled}}</span> <span class="muted">{{.CTAReason}}</span></p>{{end}}
</li>
{{end}}</ol>

<p>
{{if .UpdatePage}}<a class="button primary" href="{{.UpdatePage}}">Review plan and update website</a>
{{else}}<span class="button disabled" aria-disabled="true">Review plan and update website</span> <span class="muted">{{.UpdateReason}}</span>{{end}}
</p>
{{end}}
</section>
{{end}}{{end}}
<section id="freshness" aria-labelledby="fresh-h">
<h2 id="fresh-h">Data freshness</h2>
{{with .Fresh}}{{if .Checked}}
<p class="muted">Last checked <time datetime="{{.At}}">{{.At}}</time> (checked {{.Age}} ago).</p>
{{if .Stale}}<p class="notice warn" role="status">Catalog changed since last check. Check again to see what needs refreshing.</p>{{end}}
{{if .Reasons}}<ul>{{range .Reasons}}<li>{{.}}</li>{{end}}</ul>{{else}}<p>Everything derived from the catalog is up to date.</p>{{end}}
{{else}}<p class="muted">Freshness not checked yet. The check reads the whole database and can take a few seconds.</p>{{end}}{{end}}
<form method="post" action="/operations/freshness">
<input type="hidden" name="csrf_token" value="{{$csrf}}">
<button type="submit">Check data freshness</button>
</form>
</section>

<section aria-labelledby="actions-h">
<h2 id="actions-h">Actions</h2>
<p class="muted">Nothing runs from this page. Each action shows a preview of exactly what it will do and runs only after you confirm it. Sync is never started from here directly.</p>
{{range .Groups}}<section class="op-group">
<h3>{{.Name}}</h3>
<ul class="op-cards">
{{range .Cards}}<li class="pcard">
<p class="badges"><strong>{{.Title}}</strong>{{if .UsesNetwork}} <span class="badge warn">NETWORK</span>{{end}}{{if .Destructive}} <span class="badge bad">DESTRUCTIVE</span>{{end}}</p>
{{if .Description}}<p>{{.Description}}</p>{{end}}
{{if .Available}}<p class="muted"><span class="badge ok">Available</span></p>
<p><a class="button" href="{{.Page}}">Review…</a></p>
{{else}}<p class="notice warn">Unavailable: {{if .UnavailableReason}}{{.UnavailableReason}}{{else}}This action is not available right now.{{end}}</p>{{end}}
</li>
{{end}}</ul>
</section>
{{end}}</section>

<section id="recent" aria-labelledby="recent-h">
<h2 id="recent-h">Recent operations</h2>
{{if .RecentErr}}<p class="notice warn">{{.RecentErr}}</p>{{end}}
{{if .Recent}}<div class="table-wrap"><table>
<caption class="sr">Recent operations, newest first</caption>
<thead><tr><th scope="col">When</th><th scope="col">Action</th><th scope="col">Event</th><th scope="col">Outcome</th><th scope="col">Summary</th><th scope="col">Job</th></tr></thead>
<tbody>
{{range .Recent}}<tr><td>{{if .At}}<time datetime="{{.At}}">{{.At}}</time>{{end}}</td><td>{{.Action}}</td><td>{{.Event}}</td><td>{{.Outcome}}</td><td>{{.Summary}}</td><td>{{if .JobID}}<a href="/jobs/{{.JobID}}"><code>{{.ShortJobID}}</code></a>{{else}}—{{end}}</td></tr>
{{end}}</tbody></table></div>
{{else if not .RecentErr}}<p class="muted">No operations recorded yet.</p>{{end}}
</section>
{{else}}
<p>Maintenance actions are not available in this admin; run them from the CLI. Common commands:</p>
<ul>
<li><code>make artists-validate</code> validate the YAML catalog</li>
<li><code>make sync-all</code> sync enabled artists (needs credentials)</li>
<li><code>make db-verify</code> verify the database</li>
<li><code>make export</code> regenerate the static JSON</li>
</ul>
{{end}}
{{end}}{{end}}
