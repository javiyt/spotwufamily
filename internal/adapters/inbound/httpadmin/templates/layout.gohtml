{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
{{if .Reload}}<meta http-equiv="refresh" content="3">{{else if .Refresh}}<noscript><meta http-equiv="refresh" content="3"></noscript>{{end}}
<title>{{.Title}} · Spot Wu Family admin</title>
<link rel="stylesheet" href="/static/admin.css">
<script src="/static/admin.js" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
<strong class="brand">Spot Wu Family <span>local admin</span></strong>
{{if .Authed}}
<nav aria-label="Main">
<ul>
{{$path := .Path}}{{range .Nav}}<li><a href="{{.Path}}"{{if eq .Path $path}} aria-current="page"{{end}}>{{.Label}}</a></li>
{{end}}</ul>
</nav>
<form method="post" action="/logout" class="logout">
<input type="hidden" name="csrf_token" value="{{.CSRF}}">
<button type="submit">Sign out</button>
</form>
{{end}}
</header>
<div id="offline" class="notice offline" role="status" hidden>You appear to be offline. Changes cannot be saved until the connection to the local admin server is back.</div>
{{with .Banner}}<p class="notice warn pending-banner" role="status"><strong>{{.Text}}</strong> — <a href="/operations#pending">Review pending changes</a></p>{{end}}
<div id="toasts" class="toasts" role="status" aria-live="polite">{{if or .Flash.Message .Flash.Refresh}}<p class="toast ok" data-toast>{{with .Flash.Message}}{{.}} {{end}}{{if .Flash.Refresh}}<span class="hint-refresh">{{template "refreshhint"}}</span> {{end}}<button type="button" class="link" data-dismiss aria-label="Dismiss">×</button></p>{{end}}</div>
<main id="main" tabindex="-1">
<h1>{{.Title}}</h1>
{{template "content" .}}
</main>
<footer>Edits are validated against the whole catalog and written atomically to the YAML file. Spotify profile mappings change only through the review workflow.</footer>
</body>
</html>{{end}}
{{define "pager"}}<nav class="pager" aria-label="Pagination">
<span>{{.Total}} result{{if ne .Total 1}}s{{end}} · page {{.Page}} of {{.Pages}}</span>
{{if .HasPrev}}<a rel="prev" href="{{.PrevURL}}">Previous</a>{{end}}
{{if .HasNext}}<a rel="next" href="{{.NextURL}}">Next</a>{{end}}
</nav>{{end}}
{{define "search"}}<form method="get" action="{{.Path}}" class="search" role="search">
<label for="q">Search</label>
<input id="q" type="search" name="q" value="{{.Search}}" maxlength="100" autocomplete="off" data-hotkey="/">
<button type="submit">Search</button>
</form>{{end}}
{{define "fielderr"}}{{range .}}<p class="error">{{.}}</p>{{end}}{{end}}

{{define "refreshhint"}}Catalog changed — the database, snapshot and exports may need refreshing. <a href="/operations#pending">Review in Operations</a>.{{end}}