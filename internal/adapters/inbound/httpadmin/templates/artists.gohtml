{{define "content"}}{{with .Data}}{{template "search" .Pager}}
<table>
<caption class="sr">Artists</caption>
<thead><tr><th scope="col">Name</th><th scope="col">Slug</th><th scope="col">Category</th><th scope="col">Spotify IDs</th><th scope="col">Enabled</th></tr></thead>
<tbody>
{{range .Page.Items}}<tr><th scope="row">{{.Name}}{{if .Group}} <span class="tag">group</span>{{end}}</th><td><code>{{.Slug}}</code></td><td>{{.Category}}</td><td><span class="state {{.IDState}}">{{.IDState}}</span> ({{.IDs}})</td><td>{{if .Enabled}}yes{{else}}no{{end}}</td></tr>
{{else}}<tr><td colspan="5">No artists match.</td></tr>
{{end}}</tbody></table>
{{template "pager" .Pager}}{{end}}{{end}}
